    ["assets/editor/editor.css"].join(""),
    [
      ".telescope-editor { min-width:0; max-width:100%; border:1px solid var(--border,#adb5bd); border-radius:.4rem; overflow:hidden; background:var(--surface,var(--te-bg,#fff)); color:var(--page-fg,var(--te-fg,#222)); }\n.te-toolbar { display:flex; flex-wrap:wrap; gap:.5rem; align-items:center; padding:.5rem; border-bottom:1px solid var(--border,#adb5bd); }\n.te-toolbar label { display:flex; gap:.4rem; align-items:center; min-width:0; }\n.te-toolbar select { max-width:100%; min-width:0; }\n.te-toolbar button,.te-toolbar select { color:inherit; background:var(--surface,var(--te-bg,#fff)); border:1px solid var(--control-border,#6b7280); border-radius:.25rem; padding:.35rem .6rem; font:inherit; }\n.te-toolbar button:focus-visible,.te-toolbar select:focus-visible { outline:2px solid var(--accent,#4f46e5); outline-offset:2px; }\n.te-input { min-width:0; max-width:100%; }\n.te-plain { display:block; width:100%; max-width:100%; min-height:14rem; box-sizing:border-box; resize:vertical; border:0; padding:.75rem; color:inherit; background:inherit; font:14px/1.6 ui-monospace,monospace; white-space:pre-wrap; overflow-wrap:anywhere; }\n.te-status { min-height:1.5rem; padding:.25rem .75rem; font-size:.875rem; }\n.telescope-editor .cm-editor { min-height:14rem; color:inherit; background:inherit; }\n.telescope-editor .cm-scroller { overflow:auto; font:14px/1.6 ui-monospace,monospace; }\n.telescope-editor .cm-content { caret-color:currentColor; overflow-wrap:anywhere; }\n.telescope-editor .cm-gutters { background:var(--surface,#f1f3f5); color:var(--muted,#555); border-color:var(--border,#adb5bd); }\n.telescope-editor .cm-cursor { border-left-color:currentColor; }\n.telescope-editor .cm-selectionBackground { background:#bfd7ff!important; }\n.te-token-keyword { color:#7232a4; font-weight:600; }\n.te-token-string { color:#125b33; }\n.te-token-number { color:#8b3e00; }\n.te-token-comment { color:#56616b; font-style:italic; }\n.te-token-annotation { color:#8d300a; }\n.te-token-namespace { color:#075f7b; }\n.te-tok",
      "en-type { color:#1743a8; }\n[data-theme=\"dark\"] .telescope-editor { --te-bg:#17181f; --te-fg:#e5e7eb; }\n[data-theme=\"dark\"] .te-token-keyword { color:#d7b6ff; }\n[data-theme=\"dark\"] .te-token-string { color:#a2dfa6; }\n[data-theme=\"dark\"] .te-token-number { color:#ffbf84; }\n[data-theme=\"dark\"] .te-token-comment { color:#a6b2bf; }\n[data-theme=\"dark\"] .te-token-annotation { color:#ffbf9e; }\n[data-theme=\"dark\"] .te-token-namespace { color:#8ddced; }\n[data-theme=\"dark\"] .te-token-type { color:#a6c9ff; }\n[data-theme=\"dark\"] .telescope-editor .cm-selectionBackground { background:#374c76!important; }\n@media(prefers-color-scheme:dark) {\n  :root:not([data-theme=\"light\"]) .telescope-editor { --te-bg:#17181f; --te-fg:#e5e7eb; }\n  :root:not([data-theme=\"light\"]) .te-token-keyword { color:#d7b6ff; }\n  :root:not([data-theme=\"light\"]) .te-token-string { color:#a2dfa6; }\n  :root:not([data-theme=\"light\"]) .te-token-number { color:#ffbf84; }\n  :root:not([data-theme=\"light\"]) .te-token-comment { color:#a6b2bf; }\n  :root:not([data-theme=\"light\"]) .te-token-annotation { color:#ffbf9e; }\n  :root:not([data-theme=\"light\"]) .te-token-namespace { color:#8ddced; }\n  :root:not([data-theme=\"light\"]) .te-token-type { color:#a6c9ff; }\n}\n@media(max-width:420px) { .te-toolbar label { flex:1 1 100%; } .te-toolbar select { flex:1; } }\n",
