      "(() => {\n  'use strict';\n  function enhance(root) {\n    if (root.dataset.viewerReady) return;\n    const viewport = root.querySelector('.diagram-viewer__viewport');\n    const content = viewport?.querySelector('.diagram-viewer__content');\n    const image = content?.querySelector('svg, img');\n    if (!image) return;\n    root.dataset.viewerReady = 'true';\n    root.classList.add('diagram-viewer');\n    const scheme = matchMedia('(prefers-color-scheme: dark)');\n    let documentThemeChanged = false;\n    function resolveTheme() {\n      let preference = root.dataset.viewerTheme;\n      if (!['light', 'dark', 'system'].includes(preference)) {\n        const applied = document.documentElement.dataset.theme;\n        if (applied === 'light' || applied === 'dark') preference = applied;\n        else if (documentThemeChanged) preference = 'system';\n        else {\n          try { preference = localStorage.getItem('site-theme'); } catch { preference = 'system'; }\n        }\n      }\n      root.dataset.viewerResolvedTheme = preference === 'light' || preference === 'dark' ? preference : scheme.matches ? 'dark' : 'light';\n    }\n    scheme.addEventListener('change', resolveTheme);\n    window.addEventListener('storage', event => { if (event.key === 'site-theme') resolveTheme(); });\n    new MutationObserver(resolveTheme).observe(root, { attributes: true, attributeFilter: ['data-viewer-theme'] });\n    new MutationObserver(() => { documentThemeChanged = true; resolveTheme(); }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });\n    resolveTheme();\n    viewport.tabIndex = 0;\n    viewport.setAttribute('aria-label', viewport.getAttribute('aria-label') || 'Diagram viewport. Zoom in to pan with arrow keys or drag.');\n    const toolbar = document.createElement('div');\n    toolbar.className = 'diagram-viewer__toolbar';\n    toolbar.setAttribute('role', 'group');\n    toolbar.setAttribute('aria-label', 'Diagram view');\n    function button(name, text, action) {\n      c",
      "onst element = document.createElement('button');\n      element.type = 'button'; element.textContent = text;\n      element.setAttribute('aria-label', name); element.title = name;\n      element.addEventListener('click', event => { event.preventDefault(); event.stopPropagation(); action(); });\n      toolbar.append(element); return element;\n    }\n    let scale = 1, x = 0, y = 0, width = 0, height = 0, drag = null, suppressClick = false;\n    let modal = false, expanded = false, closed = false, priorFocus = null, oldOverflow = '', oldRole = null, oldModal = null;\n    const inerted = new Map();\n    let priorScrollX = 0, priorScrollY = 0;\n    function render() {\n      const boundX = Math.max(0, (width * scale - viewport.clientWidth) / 2 + 48);\n      const boundY = Math.max(0, (height * scale - viewport.clientHeight + 56) / 2 + 48);\n      x = Math.max(-boundX, Math.min(boundX, x)); y = Math.max(-boundY, Math.min(boundY, y));\n      content.style.transform = `translate(-50%, -50%) translate(${x}px, ${y}px) scale(${scale})`;\n      viewport.dataset.viewerScale = String(scale);\n      zoomOut.disabled = scale <= .25; zoomIn.disabled = scale >= 8;\n      label.textContent = `${Math.round(scale * 100)}%`;\n      viewport.classList.toggle('diagram-viewer__viewport--pannable', scale > 1);\n    }\n    function zoom(factor) { scale = Math.max(.25, Math.min(8, Math.round(scale * factor * 10000) / 10000)); render(); }\n    const zoomOut = button('Zoom out', '−', () => zoom(1 / 1.25));\n    const label = document.createElement('output'); label.setAttribute('aria-label', 'Diagram scale'); toolbar.append(label);\n    const zoomIn = button('Zoom in', '+', () => zoom(1.25));\n    button('Fit diagram', 'Fit', () => { scale = 1; x = y = 0; measure(); });\n    const fullscreen = button('Fullscreen', 'Fullscreen', () => { void toggleFullscreen(); });\n    viewport.append(toolbar);\n    function measure() {\n      // Hidden tabs, filtered cards and inactive theme variants have no layout.\n      // Retain the la",
      "st fitted dimensions and pan until the viewport is visible.\n      if (!viewport.clientWidth || !viewport.clientHeight) return;\n      const box = image.viewBox?.baseVal;\n      const naturalWidth = box?.width || image.naturalWidth || Number(image.getAttribute('width')) || 640;\n      const naturalHeight = box?.height || image.naturalHeight || Number(image.getAttribute('height')) || 480;\n      const fit = Math.min(Math.max(1, viewport.clientWidth - 24) / naturalWidth, Math.max(1, viewport.clientHeight - 80) / naturalHeight);\n      width = naturalWidth * fit; height = naturalHeight * fit;\n      content.style.width = `${width}px`; content.style.height = `${height}px`; render();\n    }\n    function finish() {\n      if (closed) return;\n      closed = true;\n      modal = false; expanded = false;\n      viewport.classList.remove('diagram-viewer__viewport--expanded');\n      fullscreen.textContent = 'Fullscreen'; fullscreen.setAttribute('aria-label', 'Fullscreen');\n      if (oldRole === null) viewport.removeAttribute('role'); else viewport.setAttribute('role', oldRole);\n      if (oldModal === null) viewport.removeAttribute('aria-modal'); else viewport.setAttribute('aria-modal', oldModal);\n      for (const [element, value] of inerted) element.inert = value;\n      inerted.clear();\n      document.body.style.overflow = oldOverflow;\n      measure(); priorFocus?.focus({ preventScroll: true });\n      window.scrollTo({ left: priorScrollX, top: priorScrollY, behavior: 'instant' });\n    }\n    function openModal() {\n      modal = true;\n      viewport.classList.add('diagram-viewer__viewport--expanded');\n      viewport.setAttribute('role', 'dialog'); viewport.setAttribute('aria-modal', 'true');\n      document.body.style.overflow = 'hidden';\n      for (let branch = viewport; branch.parentElement; branch = branch.parentElement) {\n        for (const sibling of branch.parentElement.children) if (sibling !== branch && sibling instanceof HTMLElement) {\n          inerted.set(sibling, sibling.inert);",
      " sibling.inert = true;\n        }\n      }\n      measure(); fullscreen.focus({ preventScroll: true });\n    }\n    async function toggleFullscreen() {\n      if (expanded) {\n        if (document.fullscreenElement === viewport) { try { await document.exitFullscreen(); } catch { finish(); } }\n        else finish();\n        return;\n      }\n      expanded = true; closed = false; priorFocus = document.activeElement;\n      priorScrollX = window.scrollX; priorScrollY = window.scrollY;\n      oldOverflow = document.body.style.overflow; oldRole = viewport.getAttribute('role'); oldModal = viewport.getAttribute('aria-modal');\n      fullscreen.textContent = 'Exit'; fullscreen.setAttribute('aria-label', 'Exit fullscreen');\n      if (viewport.requestFullscreen) {\n        try { await viewport.requestFullscreen(); measure(); fullscreen.focus({ preventScroll: true }); return; } catch { /* Keep an offline fallback when fullscreen is denied. */ }\n      }\n      if (!closed) openModal();\n    }\n    document.addEventListener('fullscreenchange', () => {\n      if (expanded && !modal && document.fullscreenElement !== viewport) finish();\n      else if (document.fullscreenElement === viewport) measure();\n    });\n    viewport.addEventListener('keydown', event => {\n      if (event.key === 'Escape' && modal) { event.preventDefault(); event.stopPropagation(); finish(); return; }\n      if (event.key === 'Tab' && modal) {\n        const items = [...viewport.querySelectorAll('button:not(:disabled), [href], input:not(:disabled), select:not(:disabled), [tabindex=\"0\"]')].filter(element => !element.hidden);\n        const first = items[0], last = items.at(-1);\n        if (event.shiftKey && (document.activeElement === first || document.activeElement === viewport)) { event.preventDefault(); last?.focus(); }\n        else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus(); }\n      }\n      if (event.target !== viewport || scale <= 1) return;\n      const directions = { Arr",
      "owLeft: [40, 0], ArrowRight: [-40, 0], ArrowUp: [0, 40], ArrowDown: [0, -40] };\n      if (directions[event.key]) { event.preventDefault(); const [dx, dy] = directions[event.key]; x += dx; y += dy; render(); }\n    });\n    viewport.addEventListener('pointerdown', event => {\n      if (scale <= 1 || !event.isPrimary || event.button !== 0 || event.target.closest('button, a, input, select, textarea, [contenteditable]')) return;\n      if (window.getSelection()?.toString()) return;\n      suppressClick = false;\n      drag = { id: event.pointerId, startX: event.clientX, startY: event.clientY, x, y, moved: false };\n      viewport.setPointerCapture(event.pointerId); viewport.focus({ preventScroll: true });\n    });\n    viewport.addEventListener('pointermove', event => {\n      if (!drag || event.pointerId !== drag.id) return;\n      const dx = event.clientX - drag.startX, dy = event.clientY - drag.startY;\n      if (!drag.moved && Math.hypot(dx, dy) < 5) return;\n      drag.moved = true; x = drag.x + dx; y = drag.y + dy; render();\n    });\n    function release(event) {\n      if (!drag || event.pointerId !== drag.id) return;\n      const id = drag.id; suppressClick = drag.moved; drag = null;\n      if (viewport.hasPointerCapture(id)) viewport.releasePointerCapture(id);\n    }\n    viewport.addEventListener('click', event => {\n      if (suppressClick && !event.target.closest('button')) { event.preventDefault(); event.stopPropagation(); suppressClick = false; }\n    }, true);\n    viewport.addEventListener('pointerup', release); viewport.addEventListener('pointercancel', release); viewport.addEventListener('lostpointercapture', release);\n    image.addEventListener('dragstart', event => event.preventDefault());\n    image.addEventListener('load', measure);\n    new ResizeObserver(measure).observe(viewport);\n    measure();\n  }\n  window.DiagramViewport = { enhance };\n  document.querySelectorAll('[data-diagram-viewer]').forEach(enhance);\n})();\n",
    ].join(""),
  ),
  (
    "assets/viewer.css",
    [
      ".diagram-viewer {\n  --dv-bg: var(--diagram-viewer-bg, var(--page-bg, #f9fafb));\n  --dv-surface: var(--diagram-viewer-surface, var(--surface, #ffffff));\n  --dv-ink: var(--diagram-viewer-ink, var(--page-fg, #111827));\n  --dv-muted: var(--diagram-viewer-muted, var(--muted, #6b7280));\n  --dv-border: var(--diagram-viewer-border, var(--line, #d1d5db));\n  --dv-accent: var(--diagram-viewer-accent, var(--accent, #4f46e5));\n  --dv-accent-ink: var(--diagram-viewer-accent-ink, #ffffff);\n  --dv-space: var(--diagram-viewer-space, .75rem);\n  color: var(--dv-ink); background: var(--dv-bg);\n  font-family: var(--diagram-viewer-font, system-ui, sans-serif);\n  font-size: var(--diagram-viewer-font-size, 15px);\n}\n.diagram-viewer[data-viewer-theme=\"dark\"], .diagram-viewer[data-viewer-resolved-theme=\"dark\"] {\n  --dv-bg: var(--diagram-viewer-bg, #0f1014); --dv-surface: var(--diagram-viewer-surface, #17181f);\n  --dv-ink: var(--diagram-viewer-ink, #e5e7eb); --dv-muted: var(--diagram-viewer-muted, #9ca3af);\n  --dv-border: var(--diagram-viewer-border, #374151); --dv-accent: var(--diagram-viewer-accent, #a5b4fc);\n  --dv-accent-ink: var(--diagram-viewer-accent-ink, #111827);\n  color-scheme: dark;\n}\n.diagram-viewer[data-viewer-theme=\"light\"], .diagram-viewer[data-viewer-resolved-theme=\"light\"] {\n  --dv-bg: var(--diagram-viewer-bg, #f9fafb); --dv-surface: var(--diagram-viewer-surface, #ffffff);\n  --dv-ink: var(--diagram-viewer-ink, #111827); --dv-muted: var(--diagram-viewer-muted, #6b7280);\n  --dv-border: var(--diagram-viewer-border, #d1d5db); --dv-accent: var(--diagram-viewer-accent, #4f46e5);\n  --dv-accent-ink: var(--diagram-viewer-accent-ink, #ffffff);\n  color-scheme: light;\n}\n.diagram-viewer__viewport { position: relative; border: 1px solid var(--dv-border); border-radius: var(--diagram-viewer-panel-radius, .75rem); background: var(--diagram-viewer-canvas-bg, var(--dv-surface)); }\n.diagram-viewer__content > :is(svg, img) { display: block; max-width: 100%; height: auto; }\n.diagram-viewer[data-vi",
      "ewer-ready=\"true\"] .diagram-viewer__viewport { height: var(--diagram-viewer-height, clamp(18rem, 60vh, 48rem)); overflow: hidden; isolation: isolate; }\n.diagram-viewer[data-viewer-ready=\"true\"] .diagram-viewer__content { position: absolute; left: 50%; top: calc(50% + 28px); transform-origin: center; }\n.diagram-viewer[data-viewer-ready=\"true\"] .diagram-viewer__content > :is(svg, img) { width: 100%; height: 100%; max-width: none; }\n.diagram-viewer__toolbar { position: absolute; z-index: 2; top: var(--dv-space); right: var(--dv-space); display: flex; flex-wrap: wrap; justify-content: flex-end; align-items: center; gap: .125rem; max-width: calc(100% - 2 * var(--dv-space)); padding: .125rem; background: var(--diagram-viewer-toolbar-bg, var(--dv-surface)); border: 1px solid var(--dv-border); border-radius: var(--diagram-viewer-control-radius, .5rem); box-shadow: 0 2px 8px #0002; }\n.diagram-viewer__toolbar button { min-width: 44px; min-height: 44px; padding: .4rem .5rem; border: 0; background: transparent; color: var(--dv-ink); font: inherit; cursor: pointer; border-radius: var(--diagram-viewer-control-radius, .5rem); }\n.diagram-viewer__toolbar button:hover { background: var(--dv-bg); }\n.diagram-viewer__toolbar button:disabled { opacity: .4; cursor: default; }\n.diagram-viewer__toolbar output { min-width: 4ch; text-align: center; font-size: .8em; font-variant-numeric: tabular-nums; }\n.diagram-viewer :focus-visible { outline: 3px solid var(--diagram-viewer-focus, var(--dv-accent)); outline-offset: 2px; }\n.diagram-viewer__viewport--pannable { cursor: grab; touch-action: none; user-select: none; }\n.diagram-viewer__viewport--pannable:active { cursor: grabbing; }\n.diagram-viewer .diagram-viewer__viewport--expanded, .diagram-viewer__viewport:fullscreen { position: fixed; inset: 0; z-index: 2147483647; width: 100%; height: 100dvh !important; border-radius: 0; background: var(--diagram-viewer-canvas-bg, var(--dv-surface)); }\n@media print {\n  .diagram-viewer .diagram-viewer__toolbar",
      " { display: none !important; }\n  .diagram-viewer[data-viewer-ready=\"true\"] .diagram-viewer__viewport { height: auto; overflow: visible; border: none; }\n  .diagram-viewer[data-viewer-ready=\"true\"] .diagram-viewer__content { position: static; width: 100% !important; height: auto !important; transform: none !important; }\n  .diagram-viewer[data-viewer-ready=\"true\"] .diagram-viewer__content > :is(svg, img) { max-width: 100%; height: auto; }\n}\n.diagram-viewer__export { padding: var(--dv-space); background: var(--dv-bg); border-top: 1px solid var(--dv-border); }\n.diagram-viewer__export summary { cursor: pointer; min-height: 44px; display: flex; align-items: center; }\n.diagram-viewer__export form { display: flex; flex-wrap: wrap; gap: var(--dv-space); padding-block: var(--dv-space); }\n.diagram-viewer__export label { display: flex; flex-direction: column; gap: .25rem; max-width: 100%; font-size: .875em; }\n.diagram-viewer__export :is(input,select,button) { min-height: 44px; max-width: 100%; color: var(--dv-ink); background: var(--dv-surface); border: 1px solid var(--dv-border); border-radius: var(--diagram-viewer-control-radius, .5rem); padding: .4rem; font: inherit; }\n.diagram-viewer__export input[type=\"checkbox\"] { align-self: start; width: 44px; }\n.diagram-viewer__status { font-size: .875em; overflow-wrap: anywhere; }\n@media print { .diagram-viewer__export { display: none !important; } }\n",
    ].join(""),
  ),
  (
    "assets/gallery-export.js",
    [
      "(() => {\n  'use strict';\n  for (const root of document.querySelectorAll('[data-diagram-viewer]')) {\n    const image = root.querySelector('.diagram-viewer__content img');\n    if (!image || root.querySelector('.diagram-viewer__export')) continue;\n    const panel = document.createElement('details');\n    panel.className = 'diagram-viewer__export';\n    const summary = document.createElement('summary');\n    summary.textContent = 'Export image';\n    const form = document.createElement('form');\n    form.setAttribute('aria-label', 'Export image options');\n    function field(name, type, value, attributes = {}) {\n      const label = document.createElement('label');\n      label.textContent = name;\n      const input = document.createElement('input');\n      Object.assign(input, {type, value}, attributes);\n      label.append(input); form.append(label); return input;\n    }\n    const formatLabel = document.createElement('label');\n    formatLabel.textContent = 'Format';\n    const format = document.createElement('select'); format.setAttribute('aria-label', 'Format');\n    for (const [value, text] of [['png', 'PNG'], ['jpeg', 'JPEG']]) {\n      const option = document.createElement('option'); option.value = value; option.textContent = text; format.append(option);\n    }\n    formatLabel.append(format); form.append(formatLabel);\n    const width = field('Width in pixels, blank for source size', 'number', '', { min: '1', max: '16384', step: '1' });\n    const background = field('Background', 'color', '#ffffff');\n    const alpha = field('Transparent PNG background', 'checkbox', ''); alpha.checked = true;\n    const quality = field('JPEG quality', 'number', '90', { min: '1', max: '100', step: '1' });\n    const button = document.createElement('button'); button.type = 'submit'; button.textContent = 'Download PNG';\n    const cancel = document.createElement('button'); cancel.type = 'button'; cancel.textContent = 'Cancel export'; cancel.hidden = true;\n    const status = document.createElement('p'); st",
      "atus.className = 'diagram-viewer__status'; status.setAttribute('role', 'status'); status.setAttribute('aria-live', 'polite');\n    let controller = null;\n    format.addEventListener('change', () => {button.textContent = `Download ${format.value.toUpperCase()}`; alpha.disabled = format.value === 'jpeg'; quality.disabled = format.value !== 'jpeg';});\n    quality.disabled = true;\n    cancel.addEventListener('click', () => controller?.abort());\n    form.addEventListener('submit', async event => {\n      event.preventDefault();\n      if (controller || !form.reportValidity()) return;\n      const selectedFormat = format.value;\n      const options = {\n        theme: root.dataset.viewerResolvedTheme || 'light',\n        background: selectedFormat === 'png' && alpha.checked ? null : background.value,\n        quality: Number(quality.value),\n        ...(width.value ? { width: Number(width.value) } : {}),\n      };\n      const job = new AbortController(); controller = job;\n      button.disabled = true; cancel.hidden = false; panel.setAttribute('aria-busy', 'true'); status.textContent = 'Preparing image…';\n      try {\n        if (typeof window.DiagramsRaster?.export !== 'function') throw new Error('The configured image converter is unavailable. SVG downloads remain available.');\n        let svg = root.querySelector('.diagram-viewer__canonical')?.content.textContent;\n        if (!svg) {\n          const response = await fetch(image.currentSrc || image.src, { signal: job.signal });\n          if (!response.ok) throw new Error(`Could not read canonical SVG (${response.status}).`);\n          svg = await response.text();\n        }\n        const result = await window.DiagramsRaster.export({\n          svg, format: selectedFormat, options, signal: job.signal,\n          onProgress: value => { if (controller === job && !job.signal.aborted) status.textContent = typeof value === 'number' ? `Exporting image: ${Math.round(value * 100)}%` : 'Exporting image…'; },\n        });\n        if (job.signal.ab",
      "orted) throw new DOMException('Export cancelled', 'AbortError');\n        const expected = selectedFormat === 'png' ? 'image/png' : 'image/jpeg';\n        if (!result || result.mediaType !== expected || !(result.width > 0 && result.height > 0) || !result.bytes?.length) throw new Error('Image conversion returned no complete image.');\n        const bytes = result.bytes instanceof Uint8Array ? result.bytes : Uint8Array.from(result.bytes);\n        const url = URL.createObjectURL(new Blob([bytes], {type: result.mediaType}));\n        const download = document.createElement('a'); download.href = url;\n        download.download = `${root.dataset.rasterName || 'diagram'}.${selectedFormat === 'jpeg' ? 'jpg' : 'png'}`;\n        document.body.append(download); download.click(); download.remove();\n        setTimeout(() => URL.revokeObjectURL(url), 1000);\n        status.textContent = `Downloaded ${selectedFormat.toUpperCase()}, ${result.width} × ${result.height} pixels.`;\n      } catch (error) {\n        status.textContent = job.signal.aborted ? 'Export cancelled.' : `Export failed: ${error?.message || String(error)}`;\n      } finally {\n        controller = null; button.disabled = false; cancel.hidden = true; panel.removeAttribute('aria-busy');\n      }\n    });\n    form.append(button, cancel); panel.append(summary, form, status); root.append(panel);\n  }\n})();\n",
    ].join(""),
  ),
]
