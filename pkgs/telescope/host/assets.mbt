    "assets/site.css",
    [
      "/* Shared shell colors and reviewed inline SVG colors. */\n:root {\n  color-scheme: light dark;\n  --page-bg: #fbfaf7;\n  --page-fg: #1d1c1a;\n  --muted: #5d5a54;\n  --line: #d9d4c9;\n  --border: #e2ded5;\n  --surface: #f2efe8;\n  --accent: #9a6b12;\n  --accent-soft: #f6ead1;\n  --note: #2f6fb3;\n  --tip: #2e7d4f;\n  --important: #7c4dbd;\n  --warning: #9a6b12;\n  --caution: #b3402f;\n  --ok: #2e7d4f;\n  --danger: #b3402f;\n  /* Layer colors of the explainer palette, from the foil-gold top layer to the slate base. */\n  --s0: #8a5a0b;\n  --s1: #9a6b12;\n  --s2: #a97f2a;\n  --s3: #8c7a4f;\n  --s4: #6f6a5c;\n  --s5: #5b6b73;\n  --s6: #4b6a86;\n  --s7: #44608f;\n  --s8: #4a5578;\n  --font-sans: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif;\n  --font-mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;\n}\n\n@media (prefers-color-scheme: dark) {\n  :root:not([data-theme=\"light\"]) {\n    --page-bg: #151412;\n    --page-fg: #ece9e2;\n    --muted: #a8a399;\n    --line: #47443e;\n    --border: #2e2c28;\n    --surface: #1e1d1a;\n    --accent: #d9a441;\n    --accent-soft: #3a2e17;\n    --note: #6ea8e8;\n    --tip: #6cc08f;\n    --important: #b48ef0;\n    --warning: #d9a441;\n    --caution: #ec7d6c;\n    --ok: #6cc08f;\n    --danger: #ec7d6c;\n    --s0: #e0b050;\n    --s1: #d9a441;\n    --s2: #cfa060;\n    --s3: #bba67a;\n    --s4: #a8a399;\n    --s5: #93a8b3;\n    --s6: #86a7c6;\n    --s7: #8aa3d4;\n    --s8: #9aa3c8;\n  }\n}\n\n:root[data-theme=\"dark\"] {\n  --page-bg: #151412;\n  --page-fg: #ece9e2;\n  --muted: #a8a399;\n  --line: #47443e;\n  --border: #2e2c28;\n  --surface: #1e1d1a;\n  --accent: #d9a441;\n  --accent-soft: #3a2e17;\n  --note: #6ea8e8;\n  --tip: #6cc08f;\n  --important: #b48ef0;\n  --warning: #d9a441;\n  --caution: #ec7d6c;\n  --ok: #6cc08f;\n  --danger: #ec7d6c;\n  --s0: #e0b050;\n  --s1: #d9a441;\n  --s2: #cfa060;\n  --s3: #bba67a;\n  --s4: #a8a399;\n  --s5: #93a8b3;\n  --s6: #86a7c6;\n  --s7: #8aa3d4;\n  --s8: #9aa3c8;\n}\n\n/* Base */\n\n* {\n  box-sizing: border-box;\n}\n\nbody {\n  margin: 0;\n  background: var(--page-bg);\n ",
      " color: var(--page-fg);\n  font-family: var(--font-sans);\n  line-height: 1.6;\n}\n\na {\n  color: var(--accent);\n}\n\ncode,\npre {\n  font-family: var(--font-mono);\n  font-size: 0.9em;\n}\n\n:not(pre) > code {\n  overflow-wrap: anywhere;\n  background: var(--surface);\n  border-radius: 4px;\n  padding: 0.1em 0.3em;\n}\n\npre {\n  background: var(--surface);\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  padding: 12px 16px;\n  overflow-x: auto;\n}\n\n/* Shiki writes both themes as CSS variables. */\n.shiki,\n.shiki span {\n  color: var(--shiki-light);\n}\n\n@media (prefers-color-scheme: dark) {\n  :root:not([data-theme=\"light\"]) .shiki,\n  :root:not([data-theme=\"light\"]) .shiki span {\n    color: var(--shiki-dark);\n  }\n}\n\n:root[data-theme=\"dark\"] .shiki,\n:root[data-theme=\"dark\"] .shiki span {\n  color: var(--shiki-dark);\n}\n\ntable {\n  border-collapse: collapse;\n  margin: 1em 0;\n  font-size: 0.95em;\n}\n\n[role=\"region\"] {\n  overflow-x: auto;\n}\n\nth,\ntd {\n  border: 1px solid var(--border);\n  padding: 6px 10px;\n  text-align: left;\n  vertical-align: top;\n}\n\ntr:first-child th,\ntr:first-child td {\n  background: var(--surface);\n  font-weight: 600;\n}\n\nimg,\nsvg {\n  max-width: 100%;\n  height: auto;\n}\n\n/* Frame */\n\n.skip-link {\n  position: absolute;\n  left: -999px;\n}\n\n.skip-link:focus {\n  left: 16px;\n  top: 16px;\n}\n\n.site-header,\n.site-footer,\nmain {\n  max-width: 76rem;\n  margin: 0 auto;\n  padding: 16px;\n}\n\n.site-header {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n  border-bottom: 1px solid var(--border);\n}\n\n.brand {\n  color: var(--page-fg);\n  font-weight: 700;\n  text-decoration: none;\n}\n\n.site-links {\n  display: flex;\n  gap: 16px;\n}\n\n.site-links a {\n  color: var(--muted);\n  text-decoration: none;\n}\n\n.site-links a.current,\n.site-links a:hover {\n  color: var(--page-fg);\n}\n\n.site-footer {\n  border-top: 1px solid var(--border);\n  color: var(--muted);\n  font-size: 0.875rem;\n}\n\na:focus-visible,\nbutton:focus-visible,\ninput:focus-visible {\n  outlin",
      "e: 3px solid var(--accent);\n  outline-offset: 3px;\n}\n\n.visually-hidden {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  overflow: hidden;\n  clip-path: inset(50%);\n  white-space: nowrap;\n}\n\n/* Islands. Each mount is empty without JavaScript, so it takes no space. */\n\n#site-search {\n  position: relative;\n  margin-left: auto;\n}\n\n.search input {\n  width: 16rem;\n  max-width: 60vw;\n  padding: 6px 10px;\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  background: var(--page-bg);\n  color: var(--page-fg);\n  font: inherit;\n}\n\n.search-results {\n  position: absolute;\n  right: 0;\n  z-index: 10;\n  width: 22rem;\n  max-width: calc(100vw - 32px);\n  margin: 4px 0 0;\n  padding: 4px;\n  list-style: none;\n  background: var(--page-bg);\n  border: 1px solid var(--border);\n  border-radius: 8px;\n}\n\n.search-results li a {\n  display: flex;\n  justify-content: space-between;\n  gap: 16px;\n  padding: 6px 8px;\n  color: var(--page-fg);\n  text-decoration: none;\n}\n\n.search-results li.selected a,\n.search-results li a:hover {\n  background: var(--surface);\n}\n\n.search-results small,\n.search-empty {\n  color: var(--muted);\n}\n\n.search-empty {\n  padding: 6px 8px;\n}\n\n.theme-toggle,\n.menu-toggle {\n  padding: 6px 10px;\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  background: var(--page-bg);\n  color: var(--page-fg);\n  font: inherit;\n  cursor: pointer;\n}\n\n.menu-toggle {\n  display: none;\n}\n\n.icon-button {\n  display: inline-grid;\n  place-items: center;\n  width: 2.25rem;\n  height: 2.25rem;\n  padding: 0;\n}\n\n.theme-icon {\n  display: block;\n  width: 1.15rem;\n  height: 1.15rem;\n  background: currentColor;\n  -webkit-mask: var(--icon) center / contain no-repeat;\n  mask: var(--icon) center / contain no-repeat;\n}\n\n.theme-system {\n  --icon: url(\"data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect x='2' y='3' width='20' height='14' rx='2'/><path d='M8 21h8M12 17v4'/></svg>\");\n",
      "}\n\n.theme-light {\n  --icon: url(\"data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='2' stroke-linecap='round'><circle cx='12' cy='12' r='4'/><path d='M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4'/></svg>\");\n}\n\n.theme-dark {\n  --icon: url(\"data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='2' stroke-linejoin='round'><path d='M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z'/></svg>\");\n}\n\n/* The copy button of a code block. The islands wrap each block in div.code-block. */\n\n.code-block {\n  position: relative;\n  margin: 1em 0;\n}\n\n.code-block > pre {\n  margin: 0;\n}\n\n.copy-button {\n  position: absolute;\n  top: 8px;\n  right: 8px;\n  display: grid;\n  place-items: center;\n  width: 2rem;\n  height: 2rem;\n  padding: 0;\n  border: 1px solid var(--border);\n  border-radius: 6px;\n  background: var(--page-bg);\n  color: var(--muted);\n  cursor: pointer;\n  opacity: 0;\n  transition: opacity 0.15s;\n}\n\n.copy-button::before {\n  content: \"\";\n  width: 1rem;\n  height: 1rem;\n  background: currentColor;\n  -webkit-mask: var(--icon) center / contain no-repeat;\n  mask: var(--icon) center / contain no-repeat;\n  --icon: url(\"data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='2' stroke-linejoin='round'><rect x='9' y='9' width='12' height='12' rx='2'/><path d='M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1'/></svg>\");\n}\n\n.copy-button[data-state=\"copied\"] {\n  color: var(--ok);\n}\n\n.copy-button[data-state=\"copied\"]::before {\n  --icon: url(\"data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><path d='M20 6L9 17l-5-5'/></svg>\");\n}\n\n.copy-button[data-state=\"failed\"] {\n  color: var(--danger);\n}\n\n.copy-button::after {\n  content: a",
      "ttr(data-tooltip);\n  position: absolute;\n  top: 50%;\n  right: calc(100% + 6px);\n  transform: translateY(-50%);\n  padding: 2px 7px;\n  border-radius: 4px;\n  background: var(--page-fg);\n  color: var(--page-bg);\n  font: 600 0.75rem/1.4 var(--font-sans);\n  white-space: nowrap;\n  pointer-events: none;\n  opacity: 0;\n  transition: opacity 0.15s;\n}\n\n.code-block:hover .copy-button,\n.copy-button:focus-visible,\n.copy-button:not([data-state=\"idle\"])[data-state] {\n  opacity: 1;\n}\n\n.copy-button:hover::after,\n.copy-button:focus-visible::after,\n.copy-button:not([data-state=\"idle\"])[data-state]::after {\n  opacity: 1;\n}\n\n@media (hover: none) {\n  .copy-button {\n    opacity: 1;\n  }\n}\n\n/* A narrow screen shows the menu button. The main links stay visible without JavaScript. */\n\n@media (max-width: 760px) {\n  .menu-toggle {\n    display: inline-block;\n  }\n\n  .site-header {\n    gap: 8px 16px;\n  }\n\n  #site-theme {\n    margin-left: auto;\n  }\n\n  #site-search {\n    order: 3;\n    margin-left: 0;\n    width: 100%;\n  }\n\n  .search input {\n    width: 100%;\n    max-width: none;\n  }\n\n  .site-links {\n    order: 4;\n  }\n\n  :root[data-js] .site-links {\n    display: none;\n    width: 100%;\n    flex-direction: column;\n    gap: 8px;\n  }\n\n  :root[data-js][data-nav-open] .site-links {\n    display: flex;\n  }\n}\n\n/* Landing page and articles */\n\n.hero h1 {\n  font-size: clamp(2rem, 6vw, 3.25rem);\n  margin-bottom: 0.25em;\n}\n\n.article-list {\n  list-style: none;\n  padding: 0;\n}\n\n.article-card {\n  border-top: 1px solid var(--border);\n  padding: 12px 0;\n}\n\n.article-meta {\n  color: var(--muted);\n  font-size: 0.875rem;\n}\n\n/* Docs pages */\n\n.docs-layout {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr);\n  gap: 24px;\n}\n\n@media (min-width: 900px) {\n  .docs-layout {\n    grid-template-columns: 14rem minmax(0, 1fr);\n  }\n}\n\n@media (min-width: 1200px) {\n  .docs-layout {\n    grid-template-columns: 14rem minmax(0, 1fr) 12rem;\n  }\n}\n\n.docs-sidebar ul,\n.docs-toc ul {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n\n.docs-side",
      "bar li,\n.docs-toc li {\n  margin: 2px 0;\n}\n\n.docs-sidebar .depth-1,\n.docs-toc .depth-1 {\n  padding-left: 12px;\n}\n\n.docs-sidebar .depth-2 {\n  padding-left: 24px;\n}\n\n.docs-sidebar a,\n.docs-toc a {\n  color: var(--muted);\n  text-decoration: none;\n}\n\n.docs-sidebar a.current,\n.docs-sidebar a:hover,\n.docs-toc a:hover {\n  color: var(--page-fg);\n}\n\n.docs-toc a[aria-current] {\n  color: var(--accent);\n  font-weight: 600;\n}\n\n.docs-sidebar a.current {\n  font-weight: 600;\n}\n\n.nav-label {\n  display: block;\n  margin: 12px 0 4px;\n  color: var(--page-fg);\n  font-size: 0.75rem;\n  font-weight: 700;\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n}\n\n.docs-rail {\n  display: none;\n}\n\n/* Keep heading navigation available when browser islands cannot run. */\n@media (max-width: 1199px) {\n  :root:not([data-js]) .docs-rail {\n    display: block;\n    grid-column: 1 / -1;\n    order: -1;\n    padding: 12px 0;\n    border-block: 1px solid var(--line);\n    font-size: 0.875rem;\n  }\n}\n\n@media (min-width: 1200px) {\n  .docs-rail {\n    display: block;\n    position: sticky;\n    top: 16px;\n    align-self: start;\n    font-size: 0.875rem;\n  }\n}\n\n.page-source {\n  margin-top: 32px;\n  font-size: 0.875rem;\n}\n\n/* Building blocks */\n\n.status-banner {\n  border: 1px solid var(--accent);\n  background: var(--accent-soft);\n  border-radius: 8px;\n  padding: 8px 12px;\n  font-weight: 600;\n}\n\n.badge {\n  display: inline-block;\n  border: 1px solid var(--accent);\n  border-radius: 999px;\n  padding: 0 6px;\n  color: var(--accent);\n  font-size: 0.7rem;\n  font-weight: 600;\n  vertical-align: middle;\n}\n\n.callout {\n  --callout: var(--note);\n  border-left: 4px solid var(--callout);\n  background: var(--surface);\n  border-radius: 0 8px 8px 0;\n  margin: 1em 0;\n  padding: 4px 16px;\n}\n\n.callout.tip {\n  --callout: var(--tip);\n}\n\n.callout.important {\n  --callout: var(--important);\n}\n\n.callout.warning {\n  --callout: var(--warning);\n}\n\n.callout.caution {\n  --callout: var(--caution);\n}\n\n.callout-label {\n  color: var(--callout);\n  font-weight:",
      " 700;\n}\n\n.diagram {\n  margin: 1.5em 0;\n  overflow-x: auto;\n}\n\n/* The diagram SVG sets its own white --bg and dark --fg. Use the page colors. */\n.diagram svg {\n  max-width: none;\n  --bg: transparent !important;\n  --fg: var(--page-fg) !important;\n}\n\n.layer-stack {\n  margin: 1.5em 0;\n}\n\n.layer-stack ol {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  counter-reset: layer;\n}\n\n.layer-stack li {\n  display: grid;\n  grid-template-columns: minmax(8rem, 14rem) minmax(0, 1fr);\n  gap: 12px;\n  border: 1px solid var(--border);\n  border-left: 4px solid var(--accent);\n  border-radius: 6px;\n  background: var(--surface);\n  margin: 4px 0;\n  padding: 6px 12px;\n}\n\n.layer-stack li:nth-child(1) { border-left-color: var(--s0); }\n.layer-stack li:nth-child(2) { border-left-color: var(--s1); }\n.layer-stack li:nth-child(3) { border-left-color: var(--s2); }\n.layer-stack li:nth-child(4) { border-left-color: var(--s3); }\n.layer-stack li:nth-child(5) { border-left-color: var(--s4); }\n.layer-stack li:nth-child(6) { border-left-color: var(--s5); }\n.layer-stack li:nth-child(7) { border-left-color: var(--s6); }\n.layer-stack li:nth-child(8) { border-left-color: var(--s7); }\n.layer-stack li:nth-child(n + 9) { border-left-color: var(--s8); }\n\n.layer-name {\n  font-weight: 600;\n}\n\n.layer-detail {\n  color: var(--muted);\n  font-family: var(--font-mono);\n  font-size: 0.875rem;\n}\n\n@media (max-width: 520px) {\n  .layer-stack li {\n    grid-template-columns: minmax(0, 1fr);\n    gap: 0;\n  }\n}\n\n/* Version trees (design D22). The deploy fills the banner of an older or unreleased version; a build\n   writes it empty, and an empty banner takes no space. */\n.version-banner:empty {\n  display: none;\n}\n\n.version-banner {\n  padding: 0.5rem 1rem;\n  border-bottom: 1px solid var(--line);\n  background: var(--accent-soft);\n  color: var(--page-fg);\n  text-align: center;\n}\n\n.version-banner p {\n  margin: 0;\n}\n\n.version-select {\n  font: inherit;\n  color: var(--page-fg);\n  background: var(--page-bg);\n  border: 1px solid var(--line);",
