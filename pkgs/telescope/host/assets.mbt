let shell_assets : Array[(String, String)] = [
  (
    "assets/site.css",
    [
      "/* Shared shell colors. Smithy palette reference and attribution are recorded in NOTICE. */\n:root {\n  color-scheme: light;\n  --page-bg: #f9fafb;\n  --page-fg: #111827;\n  --muted: #6b7280;\n  --line: #d1d5db;\n  --border: #e5e7eb;\n  --surface: #ffffff;\n  --accent: #4f46e5;\n  --accent-soft: #eef2ff;\n  --on-accent: #ffffff;\n  --control-border: #6b7280;\n  --note: #2f6fb3;\n  --tip: #2e7d4f;\n  --important: #7c4dbd;\n  --warning: #b45309;\n  --caution: #b3402f;\n  --ok: #2e7d4f;\n  --danger: #b3402f;\n  /* Indigo-to-slate layers for reviewed inline illustrations. Supplied artifacts are unchanged. */\n  --s0: #4338ca;\n  --s1: #4f46e5;\n  --s2: #6366f1;\n  --s3: #6366a8;\n  --s4: #64748b;\n  --s5: #5b6b73;\n  --s6: #4b6a86;\n  --s7: #44608f;\n  --s8: #4a5578;\n  --font-sans: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif;\n  --font-mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;\n}\n\n@media (prefers-color-scheme: dark) {\n  :root:not([data-theme=\"light\"]) {\n    --page-bg: #0f1014;\n    --page-fg: #e5e7eb;\n    --muted: #8b93a8;\n    --line: #40455a;\n    --border: #26283a;\n    --surface: #17181f;\n    --accent: #a5b4fc;\n    --accent-soft: #1e1b4b;\n    --on-accent: #1e1b4b;\n    --control-border: #8b93a8;\n    color-scheme: dark;\n    --note: #6ea8e8;\n    --tip: #6cc08f;\n    --important: #b48ef0;\n    --warning: #fbbf24;\n    --caution: #ec7d6c;\n    --ok: #6cc08f;\n    --danger: #ec7d6c;\n    --s0: #c7d2fe;\n    --s1: #a5b4fc;\n    --s2: #9ca3f5;\n    --s3: #9fa5cc;\n    --s4: #8b93a8;\n    --s5: #93a8b3;\n    --s6: #86a7c6;\n    --s7: #8aa3d4;\n    --s8: #9aa3c8;\n  }\n}\n\n:root[data-theme=\"dark\"] {\n  --page-bg: #0f1014;\n  --page-fg: #e5e7eb;\n  --muted: #8b93a8;\n  --line: #40455a;\n  --border: #26283a;\n  --surface: #17181f;\n  --accent: #a5b4fc;\n  --accent-soft: #1e1b4b;\n  --on-accent: #1e1b4b;\n  --control-border: #8b93a8;\n  color-scheme: dark;\n  --note: #6ea8e8;\n  --tip: #6cc08f;\n  --important: #b48ef0;\n  --warning: #fbbf24;\n  --caution: #ec7d6c;\n  --ok: #6cc08f;\n  --danger: #ec7d6c;\n  --s0: #",
      "c7d2fe;\n  --s1: #a5b4fc;\n  --s2: #9ca3f5;\n  --s3: #9fa5cc;\n  --s4: #8b93a8;\n  --s5: #93a8b3;\n  --s6: #86a7c6;\n  --s7: #8aa3d4;\n  --s8: #9aa3c8;\n}\n\n/* Base */\n\n* {\n  box-sizing: border-box;\n}\n\n[hidden] {\n  display: none !important;\n}\n\nbody {\n  margin: 0;\n  background: var(--page-bg);\n  color: var(--page-fg);\n  font-family: var(--font-sans);\n  line-height: 1.6;\n}\n\na {\n  color: var(--accent);\n}\n\ncode,\npre {\n  font-family: var(--font-mono);\n  font-size: 0.9em;\n}\n\n:not(pre) > code {\n  overflow-wrap: anywhere;\n  background: var(--surface);\n  border-radius: 4px;\n  padding: 0.1em 0.3em;\n}\n\npre {\n  background: var(--surface);\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  padding: 12px 16px;\n  overflow-x: auto;\n}\n\n/* Shiki writes both themes as CSS variables. */\n.shiki,\n.shiki span {\n  color: var(--shiki-light);\n}\n\n@media (prefers-color-scheme: dark) {\n  :root:not([data-theme=\"light\"]) .shiki,\n  :root:not([data-theme=\"light\"]) .shiki span {\n    color: var(--shiki-dark);\n  }\n}\n\n:root[data-theme=\"dark\"] .shiki,\n:root[data-theme=\"dark\"] .shiki span {\n  color: var(--shiki-dark);\n}\n\ntable {\n  border-collapse: collapse;\n  margin: 1em 0;\n  font-size: 0.95em;\n}\n\n[role=\"region\"] {\n  overflow-x: auto;\n}\n\nth,\ntd {\n  border: 1px solid var(--border);\n  padding: 6px 10px;\n  text-align: left;\n  vertical-align: top;\n}\n\ntr:first-child th,\ntr:first-child td {\n  background: var(--surface);\n  font-weight: 600;\n}\n\nimg,\nsvg {\n  max-width: 100%;\n  height: auto;\n}\n\n/* Frame */\n\n.skip-link {\n  position: absolute;\n  left: -999px;\n}\n\n.skip-link:focus {\n  left: 16px;\n  top: 16px;\n}\n\n.site-header,\n.site-footer,\nmain {\n  max-width: 76rem;\n  margin: 0 auto;\n  padding: 16px;\n}\n\n.site-header {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n  border-bottom: 1px solid var(--border);\n}\n\n.brand {\n  color: var(--page-fg);\n  font-weight: 700;\n  text-decoration: none;\n}\n\n.site-links {\n  display: flex;\n  gap: 16px;\n}\n\n.site-links a {\n  color: va",
      "r(--muted);\n  text-decoration: none;\n}\n\n.site-links a.current,\n.site-links a:hover {\n  color: var(--page-fg);\n}\n\n.site-footer {\n  border-top: 1px solid var(--border);\n  color: var(--muted);\n  font-size: 0.875rem;\n}\n\na:focus-visible,\nbutton:focus-visible,\ninput:focus-visible,\nselect:focus-visible,\n[tabindex]:focus-visible {\n  outline: 3px solid var(--accent);\n  outline-offset: 3px;\n}\n\n.visually-hidden {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  overflow: hidden;\n  clip-path: inset(50%);\n  white-space: nowrap;\n}\n\n/* Islands. Each mount is empty without JavaScript, so it takes no space. */\n\n#site-search {\n  position: relative;\n  margin-left: auto;\n}\n\n.search input {\n  width: 16rem;\n  max-width: 60vw;\n  padding: 6px 10px;\n  border: 1px solid var(--control-border);\n  border-radius: 8px;\n  background: var(--page-bg);\n  color: var(--page-fg);\n  font: inherit;\n}\n\n.search-results {\n  position: absolute;\n  right: 0;\n  z-index: 10;\n  width: 22rem;\n  max-width: calc(100vw - 32px);\n  margin: 4px 0 0;\n  padding: 4px;\n  list-style: none;\n  background: var(--page-bg);\n  border: 1px solid var(--border);\n  border-radius: 8px;\n}\n\n.search-results li a {\n  display: flex;\n  justify-content: space-between;\n  gap: 16px;\n  padding: 6px 8px;\n  color: var(--page-fg);\n  text-decoration: none;\n}\n\n.search-results li.selected a,\n.search-results li a:hover {\n  background: var(--surface);\n}\n\n.search-results small,\n.search-empty {\n  color: var(--muted);\n}\n\n.search-empty {\n  padding: 6px 8px;\n}\n\n.theme-toggle,\n.menu-toggle {\n  padding: 6px 10px;\n  border: 1px solid var(--control-border);\n  border-radius: 8px;\n  background: var(--page-bg);\n  color: var(--page-fg);\n  font: inherit;\n  cursor: pointer;\n}\n\n.menu-toggle {\n  display: none;\n}\n\n.icon-button {\n  display: inline-grid;\n  place-items: center;\n  width: 2.25rem;\n  height: 2.25rem;\n  padding: 0;\n}\n\n.theme-icon {\n  display: block;\n  width: 1.15rem;\n  height: 1.15rem;\n  background: currentColor;\n  -webkit-mask: var(--icon) center / contain ",
      "no-repeat;\n  mask: var(--icon) center / contain no-repeat;\n}\n\n.theme-system {\n  --icon: url(\"data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect x='2' y='3' width='20' height='14' rx='2'/><path d='M8 21h8M12 17v4'/></svg>\");\n}\n\n.theme-light {\n  --icon: url(\"data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='2' stroke-linecap='round'><circle cx='12' cy='12' r='4'/><path d='M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4'/></svg>\");\n}\n\n.theme-dark {\n  --icon: url(\"data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='2' stroke-linejoin='round'><path d='M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z'/></svg>\");\n}\n\n/* The copy button of a code block. The islands wrap each block in div.code-block. */\n\n.code-block {\n  position: relative;\n  margin: 1em 0;\n}\n\n.code-block > pre {\n  margin: 0;\n}\n\n.copy-button {\n  position: absolute;\n  top: 8px;\n  right: 8px;\n  display: grid;\n  place-items: center;\n  width: 2rem;\n  height: 2rem;\n  padding: 0;\n  border: 1px solid var(--control-border);\n  border-radius: 6px;\n  background: var(--page-bg);\n  color: var(--muted);\n  cursor: pointer;\n  opacity: 0;\n  transition: opacity 0.15s;\n}\n\n.copy-button::before {\n  content: \"\";\n  width: 1rem;\n  height: 1rem;\n  background: currentColor;\n  -webkit-mask: var(--icon) center / contain no-repeat;\n  mask: var(--icon) center / contain no-repeat;\n  --icon: url(\"data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='2' stroke-linejoin='round'><rect x='9' y='9' width='12' height='12' rx='2'/><path d='M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1'/></svg>\");\n}\n\n.copy-button[data-state=\"copied\"] {\n  color: var(--ok);\n}\n\n.copy-butto",
      "n[data-state=\"copied\"]::before {\n  --icon: url(\"data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><path d='M20 6L9 17l-5-5'/></svg>\");\n}\n\n.copy-button[data-state=\"failed\"] {\n  color: var(--danger);\n}\n\n.copy-button::after {\n  content: attr(data-tooltip);\n  position: absolute;\n  top: 50%;\n  right: calc(100% + 6px);\n  transform: translateY(-50%);\n  padding: 2px 7px;\n  border-radius: 4px;\n  background: var(--page-fg);\n  color: var(--page-bg);\n  font: 600 0.75rem/1.4 var(--font-sans);\n  white-space: nowrap;\n  pointer-events: none;\n  opacity: 0;\n  transition: opacity 0.15s;\n}\n\n.code-block:hover .copy-button,\n.copy-button:focus-visible,\n.copy-button:not([data-state=\"idle\"])[data-state] {\n  opacity: 1;\n}\n\n.copy-button:hover::after,\n.copy-button:focus-visible::after,\n.copy-button:not([data-state=\"idle\"])[data-state]::after {\n  opacity: 1;\n}\n\n@media (hover: none) {\n  .copy-button {\n    opacity: 1;\n  }\n}\n\n/* A narrow screen shows the menu button. The main links stay visible without JavaScript. */\n\n@media (max-width: 760px) {\n  .menu-toggle {\n    display: inline-block;\n  }\n\n  .site-header {\n    gap: 8px 16px;\n  }\n\n  #site-theme {\n    margin-left: auto;\n  }\n\n  #site-search {\n    order: 3;\n    margin-left: 0;\n    width: 100%;\n  }\n\n  .search input {\n    width: 100%;\n    max-width: none;\n  }\n\n  .site-links {\n    flex-wrap: wrap;\n    order: 4;\n  }\n\n  :root[data-js] .site-links {\n    display: none;\n    width: 100%;\n    flex-direction: column;\n    gap: 8px;\n  }\n\n  :root[data-js][data-nav-open] .site-links {\n    display: flex;\n  }\n}\n\n/* Landing page and articles */\n\n.hero h1 {\n  font-size: clamp(2rem, 6vw, 3.25rem);\n  margin-bottom: 0.25em;\n}\n\n.article-list {\n  list-style: none;\n  padding: 0;\n}\n\n.article-card {\n  border-top: 1px solid var(--border);\n  padding: 12px 0;\n}\n\n.article-meta {\n  color: var(--muted);\n  font-size: 0.875rem;\n}\n\n/* Docs pages */\n\n.docs-layout ",
      "{\n  display: grid;\n  grid-template-columns: minmax(0, 1fr);\n  gap: 24px;\n}\n\n@media (min-width: 900px) {\n  .docs-layout {\n    grid-template-columns: 14rem minmax(0, 1fr);\n  }\n}\n\n@media (min-width: 1200px) {\n  .docs-layout {\n    grid-template-columns: 14rem minmax(0, 1fr) 12rem;\n  }\n}\n\n.docs-sidebar ul,\n.docs-toc ul {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n\n.docs-sidebar li,\n.docs-toc li {\n  margin: 2px 0;\n}\n\n.docs-sidebar .depth-1,\n.docs-toc .depth-1 {\n  padding-left: 12px;\n}\n\n.docs-sidebar .depth-2 {\n  padding-left: 24px;\n}\n\n.docs-sidebar a,\n.docs-toc a {\n  color: var(--muted);\n  text-decoration: none;\n}\n\n.docs-sidebar a.current,\n.docs-sidebar a:hover,\n.docs-toc a:hover {\n  color: var(--page-fg);\n}\n\n.docs-toc a[aria-current] {\n  color: var(--accent);\n  font-weight: 600;\n}\n\n.docs-sidebar a.current {\n  font-weight: 600;\n}\n\n.nav-label {\n  display: block;\n  margin: 12px 0 4px;\n  color: var(--page-fg);\n  font-size: 0.75rem;\n  font-weight: 700;\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n}\n\n.docs-rail {\n  display: none;\n}\n\n/* Keep heading navigation available when browser islands cannot run. */\n@media (max-width: 1199px) {\n  :root:not([data-js]) .docs-rail {\n    display: block;\n    grid-column: 1 / -1;\n    order: -1;\n    padding: 12px 0;\n    border-block: 1px solid var(--line);\n    font-size: 0.875rem;\n  }\n}\n\n@media (min-width: 1200px) {\n  .docs-rail {\n    display: block;\n    position: sticky;\n    top: 16px;\n    align-self: start;\n    font-size: 0.875rem;\n  }\n}\n\n.page-source {\n  margin-top: 32px;\n  font-size: 0.875rem;\n}\n\n/* Building blocks */\n\n.status-banner {\n  border: 1px solid var(--accent);\n  background: var(--accent-soft);\n  border-radius: 8px;\n  padding: 8px 12px;\n  font-weight: 600;\n}\n\n.badge {\n  display: inline-block;\n  border: 1px solid var(--accent);\n  border-radius: 999px;\n  padding: 0 6px;\n  color: var(--accent);\n  font-size: 0.7rem;\n  font-weight: 600;\n  vertical-align: middle;\n}\n\n.callout {\n  --callout: var(--note);\n  border-left: 4px s",
      "olid var(--callout);\n  background: var(--surface);\n  border-radius: 0 8px 8px 0;\n  margin: 1em 0;\n  padding: 4px 16px;\n}\n\n.callout.tip {\n  --callout: var(--tip);\n}\n\n.callout.important {\n  --callout: var(--important);\n}\n\n.callout.warning {\n  --callout: var(--warning);\n}\n\n.callout.caution {\n  --callout: var(--caution);\n}\n\n.callout-label {\n  color: var(--callout);\n  font-weight: 700;\n}\n\n.diagram {\n  margin: 1.5em 0;\n  overflow-x: auto;\n}\n\n/* The diagram SVG sets its own white --bg and dark --fg. Use the page colors. */\n.diagram svg {\n  max-width: none;\n  --bg: transparent !important;\n  --fg: var(--page-fg) !important;\n}\n\n.layer-stack {\n  margin: 1.5em 0;\n}\n\n.layer-stack ol {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  counter-reset: layer;\n}\n\n.layer-stack li {\n  display: grid;\n  grid-template-columns: minmax(8rem, 14rem) minmax(0, 1fr);\n  gap: 12px;\n  border: 1px solid var(--border);\n  border-left: 4px solid var(--accent);\n  border-radius: 6px;\n  background: var(--surface);\n  margin: 4px 0;\n  padding: 6px 12px;\n}\n\n.layer-stack li:nth-child(1) { border-left-color: var(--s0); }\n.layer-stack li:nth-child(2) { border-left-color: var(--s1); }\n.layer-stack li:nth-child(3) { border-left-color: var(--s2); }\n.layer-stack li:nth-child(4) { border-left-color: var(--s3); }\n.layer-stack li:nth-child(5) { border-left-color: var(--s4); }\n.layer-stack li:nth-child(6) { border-left-color: var(--s5); }\n.layer-stack li:nth-child(7) { border-left-color: var(--s6); }\n.layer-stack li:nth-child(8) { border-left-color: var(--s7); }\n.layer-stack li:nth-child(n + 9) { border-left-color: var(--s8); }\n\n.layer-name {\n  font-weight: 600;\n}\n\n.layer-detail {\n  color: var(--muted);\n  font-family: var(--font-mono);\n  font-size: 0.875rem;\n}\n\n@media (max-width: 520px) {\n  .layer-stack li {\n    grid-template-columns: minmax(0, 1fr);\n    gap: 0;\n  }\n}\n\n/* Version trees (design D22). The deploy fills the banner of an older or unreleased version; a build\n   writes it empty, and an empty banner takes no ",
      "space. */\n.version-banner:empty {\n  display: none;\n}\n\n.version-banner {\n  padding: 0.5rem 1rem;\n  border-bottom: 1px solid var(--line);\n  background: var(--accent-soft);\n  color: var(--page-fg);\n  text-align: center;\n}\n\n.version-banner p {\n  margin: 0;\n}\n\n.version-select {\n  font: inherit;\n  color: var(--page-fg);\n  background: var(--page-bg);\n  border: 1px solid var(--control-border);\n  border-radius: 4px;\n  padding: 0.2rem 0.4rem;\n}\n\n/* Gallery specimens. The base HTML remains a complete family catalogue without islands. */\n.gallery-index h1,\n.gallery-detail h1 {\n  margin: 0 0 0.5rem;\n  font-size: clamp(2rem, 4vw, 3rem);\n  line-height: 1.15;\n  letter-spacing: -0.035em;\n}\n\n.gallery-index,\n.gallery-detail {\n  padding: 1.5rem 0 3rem;\n}\n\n.gallery-layout {\n  display: grid;\n  grid-template-columns: 11rem minmax(0, 1fr);\n  gap: clamp(1.5rem, 4vw, 3rem);\n}\n\n.gallery-rail {\n  display: grid;\n  gap: 0.25rem;\n  align-self: start;\n  position: sticky;\n  top: 1.5rem;\n}\n\n.gallery-rail nav,\n.gallery-rail ul {\n  display: grid;\n  gap: 0.25rem;\n  padding: 0;\n  margin: 0;\n  list-style: none;\n}\n\n.gallery-rail h2 {\n  margin: 0 0 0.75rem;\n  font-size: 0.75rem;\n  color: var(--muted);\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n}\n\n.gallery-rail a {\n  display: block;\n  padding: 0.45rem 0.75rem;\n  border-radius: 0.5rem;\n  color: var(--muted);\n  text-decoration: none;\n  overflow-wrap: anywhere;\n}\n\n.gallery-rail a:hover,\n.gallery-rail a[aria-current] {\n  background: var(--accent-soft);\n  color: var(--accent);\n}\n\n.gallery-main,\n.gallery-group,\n.gallery-panel,\n.gallery-source-file {\n  min-width: 0;\n}\n\n.gallery-main > p,\n.gallery-detail > p {\n  color: var(--muted);\n  max-width: 65ch;\n}\n\n.gallery-tools {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: flex-end;\n  gap: 0.75rem 1rem;\n  margin: 1.75rem 0;\n}\n\n.gallery-tools label {\n  flex: 1 1 16rem;\n  font-size: 0.875rem;\n  color: var(--muted);\n}\n\n.gallery-tools input {\n  display: block;\n  width: 100%;\n  margin-top: 0.35rem;\n  border: 1",
      "px solid var(--control-border);\n  border-radius: 0.5rem;\n  padding: 0.65rem 0.8rem;\n  font: inherit;\n  color: var(--page-fg);\n  background: var(--surface);\n}\n\n.gallery-results {\n  margin: 0;\n  padding-bottom: 0.65rem;\n  color: var(--muted);\n  font-size: 0.875rem;\n}\n\n.gallery-groups {\n  display: grid;\n  gap: 2rem;\n}\n\n.gallery-group > h2 {\n  font-size: 1.1rem;\n  margin: 0 0 0.75rem;\n  scroll-margin-top: 1rem;\n}\n\n.gallery-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));\n  align-items: stretch;\n  gap: 1rem;\n  padding: 0;\n  margin: 0;\n  list-style: none;\n}\n\n.gallery-card {\n  min-width: 0;\n  overflow: hidden;\n  background: var(--surface);\n  border: 1px solid var(--border);\n  border-radius: 0.8rem;\n}\n\n.gallery-card:hover,\n.gallery-card:focus-within {\n  border-color: var(--accent);\n}\n\n.gallery-card-link {\n  display: flex;\n  flex-direction: column;\n  height: 100%;\n  color: var(--page-fg);\n  text-decoration: none;\n}\n\n.gallery-card-link:hover {\n  text-decoration: none;\n}\n\n.gallery-card-preview {\n  display: grid;\n  place-items: center;\n  aspect-ratio: 8 / 5;\n  margin: 0.6rem;\n  padding: 1rem;\n  border: 1px solid var(--border);\n  border-radius: 0.5rem;\n  overflow: hidden;\n  background: #ffffff;\n  color: #111827;\n}\n\n.gallery-card-preview img {\n  display: block;\n  width: 100%;\n  height: 100%;\n  min-height: 0;\n  object-fit: contain;\n}\n\n.gallery-card-body {\n  display: grid;\n  gap: 0.65rem;\n  padding: 0.65rem 1rem 1rem;\n}\n\n.gallery-card-title {\n  margin: 0;\n  font-size: 0.95rem;\n  font-weight: 650;\n  line-height: 1.5;\n  overflow-wrap: anywhere;\n}\n\n.gallery-card-meta {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  justify-content: space-between;\n  gap: 0.4rem;\n  color: var(--muted);\n  font-size: 0.75rem;\n}\n\n.gallery-badge {\n  padding: 0.15rem 0.45rem;\n  border-radius: 0.35rem;\n  background: var(--accent-soft);\n  color: var(--accent);\n  font-size: 0.75rem;\n  font-weight: 600;\n}\n\n.gallery-empty {\n  padding: 3rem 1.25rem;\n ",
      " text-align: center;\n  background: var(--surface);\n  border: 1px dashed var(--control-border);\n  border-radius: 0.8rem;\n}\n\n.gallery-workbench {\n  margin-top: 1.5rem;\n  border: 1px solid var(--border);\n  border-radius: 0.8rem;\n  background: var(--surface);\n  overflow: hidden;\n}\n\n.gallery-tabs {\n  display: flex;\n  gap: 1.25rem;\n  padding: 0 1rem;\n  border-bottom: 1px solid var(--border);\n}\n\n.gallery-tab {\n  padding: .8rem .1rem .65rem;\n  border: 0;\n  border-bottom: 3px solid transparent;\n  border-radius: 0;\n  background: transparent;\n  color: var(--muted);\n  font: inherit;\n  font-size: .875rem;\n  font-weight: 600;\n  cursor: pointer;\n}\n\n.gallery-tab:hover { color: var(--accent); }\n.gallery-tab[aria-selected=\"true\"] {\n  color: var(--accent);\n  border-bottom-color: var(--accent);\n}\n\n.gallery-actions button,\n.gallery-empty button,\n.gallery-source button {\n  padding: 0.5rem 0.8rem;\n  border: 1px solid var(--control-border);\n  border-radius: 0.45rem;\n  background: var(--surface);\n  color: var(--page-fg);\n  font: inherit;\n  font-size: 0.875rem;\n  cursor: pointer;\n}\n\n.gallery-panel {\n  padding: clamp(1rem, 3vw, 2rem);\n}\n\n.gallery-preview {\n  margin: 0;\n  padding: clamp(1rem, 3vw, 2rem);\n  overflow: auto;\n  border-radius: 0.5rem;\n  background: #ffffff;\n  color: #111827;\n  text-align: center;\n}\n\n.gallery-preview img {\n  display: block;\n  max-width: 100%;\n  max-height: 36rem;\n  width: auto;\n  height: auto;\n  margin: auto;\n  object-fit: contain;\n}\n\n.gallery-preview a {\n  color: #4f46e5;\n}\n\n.gallery-preview figcaption {\n  margin-top: 1rem;\n  font-size: 0.875rem;\n}\n\n.gallery-source pre {\n  max-width: 100%;\n  padding: 1rem;\n  overflow: auto;\n  white-space: pre;\n  background: var(--page-bg);\n  line-height: 1.65;\n}\n\n.gallery-source-file + .gallery-source-file {\n  margin-top: 2rem;\n}\n\n.gallery-source-heading,\n.gallery-actions {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 0.75rem 1.25rem;\n}\n\n.gallery-source-heading h2,\n.gallery-source-heading h3 {\n  margin: 0;\n  fo",
      "nt-size: 0.9rem;\n  overflow-wrap: anywhere;\n}\n\n.gallery-actions {\n  padding: 1rem 0;\n  font-size: 0.875rem;\n}\n\n.gallery-scope {\n  margin: 1rem 0;\n  padding: 0.8rem 1rem;\n  border-left: 3px solid var(--accent);\n  background: var(--accent-soft);\n  color: var(--page-fg);\n  font-size: 0.875rem;\n}\n\n.gallery-dark {\n  display: none;\n}\n\n:root[data-theme=\"dark\"] .gallery-light:not(.gallery-light-only) {\n  display: none;\n}\n\n:root[data-theme=\"dark\"] .gallery-dark:not([hidden]) {\n  display: block;\n}\n\n:root[data-theme=\"dark\"] .gallery-preview.gallery-dark:not(.diagram-viewer),\n:root[data-theme=\"dark\"] .gallery-card-preview.gallery-dark:not(.diagram-viewer) {\n  background: #161b22;\n  color: #f0f6fc;\n}\n\n:root[data-theme=\"dark\"] .gallery-preview.gallery-dark a {\n  color: #a5b4fc;\n}\n\n@media (prefers-color-scheme: dark) {\n  :root:not([data-theme=\"light\"]) .gallery-light:not(.gallery-light-only) {\n    display: none;\n  }\n  :root:not([data-theme=\"light\"]) .gallery-dark:not([hidden]) {\n    display: block;\n  }\n  :root:not([data-theme=\"light\"]) .gallery-preview.gallery-dark:not(.diagram-viewer),\n  :root:not([data-theme=\"light\"]) .gallery-card-preview.gallery-dark:not(.diagram-viewer) {\n    background: #161b22;\n    color: #f0f6fc;\n  }\n  :root:not([data-theme=\"light\"]) .gallery-preview.gallery-dark a {\n    color: #a5b4fc;\n  }\n}\n\n@media (max-width: 760px) {\n  .gallery-layout {\n    grid-template-columns: minmax(0, 1fr);\n    gap: 1.5rem;\n  }\n  .gallery-rail {\n    position: static;\n    display: flex;\n    flex-wrap: wrap;\n    gap: 0.25rem;\n  }\n  .gallery-rail nav,\n  .gallery-rail ul {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 0.25rem;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  *,\n  *::before,\n  *::after {\n    scroll-behavior: auto !important;\n    transition-duration: 0s !important;\n    animation-duration: 0s !important;\n  }\n}\n\n/* Enhanced browsing combines families into one grid; the static headings keep their anchors. */\n[data-gallery-index][data-enhanced] .gallery-groups {\n  grid",
      "-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));\n  gap: 1rem;\n}\n\n[data-gallery-index][data-enhanced] .gallery-group,\n[data-gallery-index][data-enhanced] .gallery-grid {\n  display: contents;\n}\n\n[data-gallery-index][data-enhanced] .gallery-group > h2 {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  overflow: hidden;\n  clip-path: inset(50%);\n  white-space: nowrap;\n}\n\n.gallery-tabs:empty,\n.gallery-tools:empty {\n  display: none;\n}\n\n\n.site-links a.current {\n  color: var(--accent);\n  font-weight: 600;\n}\n\n.gallery-card-body > p {\n  margin: 0;\n}\n\n.gallery-card-body > p:not(.gallery-card-meta) {\n  color: var(--muted);\n  font-size: 0.8rem;\n  line-height: 1.5;\n}\n\n.gallery-tools > button,\n.gallery-empty button {\n  padding: 0.65rem 0.8rem;\n  border: 1px solid var(--accent);\n  border-radius: 0.5rem;\n  background: var(--accent);\n  color: var(--on-accent);\n  font: inherit;\n  font-size: 0.875rem;\n  cursor: pointer;\n}\n\n.gallery-source-heading {\n  font-size: 0.95rem;\n  overflow-wrap: anywhere;\n}\n\n.gallery-placeholder {\n  display: grid;\n  align-content: center;\n  min-height: 10rem;\n  padding: 1rem;\n  margin: 0.6rem;\n  text-align: center;\n  color: var(--muted);\n  background: var(--page-bg);\n  border-radius: 0.5rem;\n}\n\n/* Detail metadata reads as one sentence; card metadata keeps its compact row. */\n.gallery-detail > .gallery-card-meta {\n  display: block;\n  font-size: 0.875rem;\n}\n\n.gallery-workbench[data-enhanced] > .gallery-panel > h2 {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  overflow: hidden;\n  clip-path: inset(50%);\n  white-space: nowrap;\n}\n\n/* Tutorial reading remains available before enhancement and without scripts. */\n.tutorial-contents ol { padding-inline-start: 1.5rem; }\n.tutorial-contents [aria-current=\"page\"] { font-weight: 700; }\n.tutorial-controls { display: flex; flex-wrap: wrap; gap: .5rem; margin-block: .75rem; }\n.tutorial-panes { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 1rem; }\n.tutorial-panes > *, [da",
      "ta-tutorial-workspace], .tutorial-starting { min-width: 0; max-width: 100%; }\n.tutorial-results pre, .tutorial-starting pre { max-width: 100%; overflow: auto; }\n.tutorial-results select { max-width: 100%; }\n.tutorial-results p { overflow-wrap: anywhere; }\n.tutorial-changed-line { display: inline; background: color-mix(in srgb, var(--accent) 18%, transparent); }\n.tutorial-expanded .tutorial-panes { grid-template-columns: minmax(0, 1fr); }\n@media (max-width: 720px) { .tutorial-panes { grid-template-columns: minmax(0, 1fr); } }\n\n.brand { display: inline-flex; align-items: center; gap: .5rem; }\n.brand img { width: 32px; height: 32px; object-fit: contain; }\n.gallery-card-preview.diagram-viewer { padding: 0; height: auto; }\n.gallery-card-preview.diagram-viewer .diagram-viewer__viewport { --diagram-viewer-height: 20rem; border: none; border-radius: 0; }\n.gallery-preview.diagram-viewer { padding: 0; }\n.gallery-card-link.gallery-card-title { display: inline; }\n\n.gallery-card-preview.diagram-viewer { aspect-ratio: auto; }\n.gallery-card-preview.diagram-viewer .diagram-viewer__viewport { width: 100%; }\n\n/* Public gallery classes apply to card and detail inspection alike. */\n.gallery-card > .gallery-workbench {\n  margin: 0;\n  min-width: 0;\n  border: 0;\n  border-radius: 0;\n}\n.gallery-card .gallery-panel { padding: .6rem; min-width: 0; }\n.gallery-card .gallery-source pre { max-height: var(--gallery-card-source-height, 20rem); }\n.gallery-card .gallery-source-file { min-width: 0; }\n.gallery-card .gallery-actions a { overflow-wrap: anywhere; }\n\n.gallery-source-select { display: grid; gap: .4rem; margin-bottom: 1rem; }\n.gallery-source-select select {\n  min-width: 0;\n  max-width: 100%;\n  padding: .5rem;\n  border: 1px solid var(--control-border);\n  border-radius: .45rem;\n  background: var(--surface);\n  color: var(--page-fg);\n  font: inherit;\n}\n",
