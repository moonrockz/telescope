----
import {
  "moonbitlang/async@0.22.7",
  "moonbitlang/async@0.22.7/fs",
  "moonbitlang/async@0.22.7/process",
  "moonbitlang/async@0.22.7/stdio",
  "moonbitlang/x@0.5.5/sys",
}
----

///|
/// Format setup scripts without requiring a not-yet-created engine module.

///|
async fn main {
  let engine = @process.run(
    "moon",
    ["fmt"],
    stdout=@stdio.stdout,
    stderr=@stdio.stderr,
  )
  if engine != 0 {
    @sys.exit(1)
  }
  let args = ["fmt"]
  for file in @fs.readdir("scripts", sort=true) {
    if file.has_suffix(".mbtx") {
      args.push("scripts/\{file}")
    }
  }
  let code = @process.run(
    "moon",
    args,
    stdout=@stdio.stdout,
    stderr=@stdio.stderr,
  )
  if code != 0 {
    @sys.exit(if code > 0 { code } else { 1 })
  }
}
