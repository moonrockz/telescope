///|
/// Publication runs only in the owner-approved Actions job, never on a workstation.
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/process",
  "moonbitlang/async@0.22.5/stdio",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/x@0.5.5/sys",
}

///|
async fn main {
  guard @env.get_env_var("GITHUB_ACTIONS") == Some("true") &&
    @env.get_env_var("RUNNER_ENVIRONMENT") == Some("github-hosted") else {
    eprintln(
      "Publication requires the approved GitHub-hosted Actions release job",
    )
    @sys.exit(1)
    return
  }
  let gate = @process.run(
    "moonx",
    ["scripts/release-approval.mbtx"],
    stdout=@stdio.stdout,
    stderr=@stdio.stderr,
  )
  guard gate == 0 else {
    @sys.exit(1)
    return
  }
  let token = @env.get_env_var("MOONCAKES_TOKEN").unwrap_or("")
  guard token != "" else {
    eprintln("Missing Actions Mooncakes credential")
    @sys.exit(1)
    return
  }
  let toolchain = @env.get_env_var("MOON_HOME").unwrap()
  let home = @fs.tmpdir(prefix="telescope-publish")
  defer @fs.rmdir(home, recursive=true)
  prepare_home(toolchain, home)
  let credential : Json = { "token": token }
  @fs.write_file(
    home + "/credentials.json",
    credential.stringify(),
    permission=0o600,
  )
  let dry_run = @env.args().contains("--dry-run")
  let command = if dry_run { ["publish", "--dry-run"] } else { ["publish"] }
  let (code, output, error) = @process.collect_output(
    "moon",
    command,
    cwd=@env.get_env_var("RUNNER_TEMP").unwrap() + "/telescope-library",
    extra_env=Map::from_array([("MOON_HOME", home)]),
  )
  if output.text() != "" {
    println(output.text())
  }
  if error.text() != "" {
    eprintln(error.text())
  }
  guard publication_succeeded(
    code,
    dry_run,
    @env.get_env_var("RELEASE_VERSION").unwrap(),
    output.text() + "\n" + error.text(),
  ) else {
    eprintln("Library publication failed; CLI release was not created")
    @sys.exit(1)
    return
  }
  if code != 0 {
    println(
      "Mooncakes confirmed the exact dry run; accepted the pinned CLI's HTTP 202 exit-code quirk.",
    )
  }
}

///|
/// The pinned CLI reports an error for the server's successful dry-run HTTP 202.
/// Only that exact receipt for this module/version can override a dry-run exit.
fn publication_succeeded(
  code : Int32,
  dry_run : Bool,
  version : String,
  output : String,
) -> Bool {
  if code == 0 {
    return true
  }
  if !dry_run || code < 1 || version == "" {
    return false
  }
  let statuses = output
    .split("\n")
    .map(line => line.trim().to_owned())
    .filter(line => line.has_prefix("Server status: "))
    .collect()
  statuses ==
  [
    "Server status: 202 Accepted, detail: Dry run completed successfully. No changes were made. The dry-run was made for package moonrockz/telescope version " +
    version +
    ".",
  ]
}

///|
test "only the exact server-accepted dry run can override a failed CLI exit" {
  let receipt = "Server status: 202 Accepted, detail: Dry run completed successfully. No changes were made. The dry-run was made for package moonrockz/telescope version 0.1.0."
  assert_true(publication_succeeded(0, false, "0.1.0", ""))
  assert_true(publication_succeeded(255, true, "0.1.0", receipt))
  assert_false(publication_succeeded(255, false, "0.1.0", receipt))
  assert_false(publication_succeeded(-9, true, "0.1.0", receipt))
  assert_false(publication_succeeded(255, true, "0.1.1", receipt))
  assert_false(publication_succeeded(255, true, "0.1.0", "Check failed"))
  assert_false(
    publication_succeeded(
      255,
      true,
      "0.1.0",
      receipt.replace(old="moonrockz/telescope", new="moonrockz/other"),
    ),
  )
  assert_false(
    publication_succeeded(
      255,
      true,
      "0.1.0",
      receipt.replace(old="202 Accepted", new="403 Forbidden"),
    ),
  )
  assert_false(
    publication_succeeded(
      255,
      true,
      "0.1.0",
      receipt + "\nServer status: 500 Internal Server Error",
    ),
  )
}

///|
async fn prepare_home(toolchain : String, home : String) -> Unit {
  for name in ["bin", "lib", "include", "registry"] {
    if @fs.exists(toolchain + "/" + name) {
      @fs.symlink(target=toolchain + "/" + name, home + "/" + name)
    }
  }
}

///|
async test "publisher home packages the qualified library without a credential" {
  let toolchain = @env.get_env_var("MOON_HOME").unwrap()
  let archive = @env.get_env_var("TELESCOPE_PACKAGE_ARCHIVE").unwrap()
  let temp = @fs.tmpdir(prefix="telescope-publish-test")
  defer @fs.rmdir(temp, recursive=true)
  let home = temp + "/home"
  @fs.mkdir(home)
  prepare_home(toolchain, home)
  assert_false(@fs.exists(home + "/credentials.json"))
  let source = temp + "/source"
  let (unpacked, _, unpack_error) = @process.collect_output("unzip", [
    "-q", archive, "-d", source,
  ])
  assert_eq(unpacked, 0, msg=unpack_error.text())
  let (status, output, error) = @process.collect_output(
    toolchain + "/bin/moon",
    ["package"],
    cwd=source,
    extra_env=Map::from_array([("MOON_HOME", home)]),
  )
  assert_eq(status, 0, msg=output.text() + error.text())
  assert_false(@fs.exists(home + "/credentials.json"))
}
