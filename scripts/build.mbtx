///|
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/process",
  "moonbitlang/async@0.22.5/stdio",
  "moonbitlang/core/json",
  "moonbitlang/x@0.5.5/sys",
}

///|
async fn run(command : String, args : Array[String]) -> Unit {
  let code = @process.run(
    command,
    args,
    stdout=@stdio.stdout,
    stderr=@stdio.stderr,
  )
  guard code == 0 else { @sys.exit(1) }
}

///|
async fn main {
  run("moon", [
    "-C", "pkgs/telescope", "build", "--target", "js", "islands", "--release",
  ])
  @fs.mkdir("_build/telescope", recursive=true, allow_exist=true)
  run("bun", [
    "build", "_build/js/release/build/moonrockz/telescope/islands/islands.js", "--target",
    "browser", "--minify", "--outfile", "_build/telescope/islands.js",
  ])
  run("npm", ["ci", "--prefix", "pkgs/telescope/editor/browser"])
  let component_assets : Array[(String, String)] = []
  for
    (entry, directory) in [
      ("editor/browser/editor.js", "editor"),
      ("tutorial/islands/workspace.js", "tutorial"),
    ] {
    let outdir = "_build/components/" + directory
    if @fs.exists(outdir) {
      @fs.rmdir(outdir, recursive=true)
    }
    run("bun", [
      "build",
      "pkgs/telescope/" + entry,
      "--target",
      "browser",
      "--minify",
      "--splitting",
      "--outdir",
      outdir,
    ])
    collect_components(outdir, "assets/" + directory, component_assets)
  }
  component_assets.push(
    (
      "assets/editor/editor.css",
      @fs.read_file("pkgs/telescope/editor/browser/editor.css").text(),
    ),
  )
  component_assets.push(
    (
      "assets/editor/THIRD-PARTY-LICENSES.txt",
      @fs.read_file("pkgs/telescope/editor/browser/THIRD-PARTY-LICENSES.txt").text(),
    ),
  )
  @fs.write_file(
    "pkgs/telescope/host/component_assets.mbt",
    "///| Generated by scripts/build.mbtx.\nlet component_assets : Array[(String,String)] = [" +
    component_assets
    .map(asset => "(" + literal(asset.0) + "," + literal(asset.1) + ")")
    .join(",\n") +
    "]\n",
    create_mode=CreateOrTruncate,
  )
  run("moon", ["fmt", "pkgs/telescope/host/component_assets.mbt"])
  let css = @fs.read_file("pkgs/telescope/assets/site.css").text()
  let js = @fs.read_file("_build/telescope/islands.js").text()
  let text = "///| Generated by scripts/build.mbtx.\nlet shell_assets : Array[(String,String)] = [(\"assets/site.css\",\{literal(css)}),(\"assets/islands.js\",\{literal(js)})]\n"
  @fs.write_file(
    "pkgs/telescope/host/assets.mbt",
    text,
    create_mode=CreateOrTruncate,
  )
  run("moon", ["fmt", "pkgs/telescope/host/assets.mbt"])
  run("moon", [
    "-C", "apps/telescope", "build", "--target", "native", "--release",
  ])
  // Replace the executable through a fresh inode. Truncating a running preview
  // binary can leave macOS rejecting the replacement with SIGKILL even when its
  // bytes and on-disk signature match the compiler output.
  let staged_cli = "_build/telescope/telescope.next"
  @fs.write_file(
    staged_cli,
    @fs.read_file(
      "_build/native/release/build/moonrockz/telescope-cli/cmd/cmd.exe",
    ).binary(),
    create_mode=CreateOrTruncate,
    permission=0o755,
  )
  @fs.chmod(staged_cli, 0o755)
  @fs.rename(staged_cli, "_build/telescope/telescope")
  run("_build/telescope/telescope", ["--version"])
}

///|
fn literal(text : String) -> String {
  let chunks = []
  let mut i = 0
  while i < text.length() {
    let end = Int32::min(i + 2000, text.length())
    chunks.push(Json::string(text[i:end].to_owned()).stringify())
    i = end
  }
  "[\n" + chunks.join(",\n") + "\n].join(\"\")"
}

///|
async fn collect_components(
  root : String,
  prefix : String,
  assets : Array[(String, String)],
) -> Unit {
  for name in @fs.readdir(root, sort=true) {
    let path = root + "/" + name
    if @fs.kind(path) is Directory {
      collect_components(path, prefix + "/" + name, assets)
    } else {
      assets.push((prefix + "/" + name, @fs.read_file(path).text()))
    }
  }
}
