///|
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/process",
  "moonbitlang/async@0.22.5/stdio",
  "moonbitlang/core/json",
  "moonbitlang/x@0.5.5/sys",
}

///|
async fn run(command : String, args : Array[String]) -> Unit {
  let code = @process.run(
    command,
    args,
    stdout=@stdio.stdout,
    stderr=@stdio.stderr,
  )
  guard code == 0 else { @sys.exit(1) }
}

///|
async fn main {
  run("moon", [
    "-C", "pkgs/telescope", "build", "--target", "js", "islands", "--release",
  ])
  @fs.mkdir("_build/telescope", recursive=true, allow_exist=true)
  run("bun", [
    "build", "_build/js/release/build/moonrockz/telescope/islands/islands.js", "--target",
    "browser", "--minify", "--outfile", "_build/telescope/islands.js",
  ])
  let css = @fs.read_file("pkgs/telescope/assets/site.css").text()
  let js = @fs.read_file("_build/telescope/islands.js").text()
  let text = "///| Generated by scripts/build.mbtx.\nlet shell_assets : Array[(String,String)] = [(\"assets/site.css\",\{literal(css)}),(\"assets/islands.js\",\{literal(js)})]\n"
  @fs.write_file(
    "pkgs/telescope/host/assets.mbt",
    text,
    create_mode=CreateOrTruncate,
  )
  run("moon", ["fmt", "pkgs/telescope/host/assets.mbt"])
  run("moon", [
    "-C", "apps/telescope", "build", "--target", "native", "--release",
  ])
  @fs.write_file(
    "_build/telescope/telescope",
    @fs.read_file(
      "_build/native/release/build/moonrockz/telescope-cli/cmd/cmd.exe",
    ).binary(),
    create_mode=CreateOrTruncate,
    permission=0o755,
  )
  @fs.chmod("_build/telescope/telescope", 0o755)
  run("_build/telescope/telescope", ["--version"])
}

///|
fn literal(text : String) -> String {
  let chunks = []
  let mut i = 0
  while i < text.length() {
    let end = Int32::min(i + 2000, text.length())
    chunks.push(Json::string(text[i:end].to_owned()).stringify())
    i = end
  }
  "[\n" + chunks.join(",\n") + "\n].join(\"\")"
}
