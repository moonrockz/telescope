///|
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/process",
  "moonbitlang/async@0.22.5/stdio",
  "moonbitlang/x@0.5.5/sys",
}

///|
/// Qualify the native library host on the current OS using the pinned Moon toolchain.
async fn main {
  for command in ["check", "test"] {
    let code = @process.run(
      "moon",
      [
        "-C", "pkgs/telescope", command, "host", "--target", "native", "--deny-warn",
      ],
      stdout=@stdio.stdout,
      stderr=@stdio.stderr,
    )
    if code != 0 {
      @sys.exit(if code > 0 { code } else { 1 })
    }
  }
}
